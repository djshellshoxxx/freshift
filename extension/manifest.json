{
  "manifest_version": 3,
  "name": "FreshSift Local Fetch Bridge",
  "version": "0.1.0",
  "description": "Optional locally installed HTTP(S) fetch bridge for FreshSift GitHub Pages. No remote proxy.",
  "permissions": [],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://djshellshoxxx.github.io/freshift/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
